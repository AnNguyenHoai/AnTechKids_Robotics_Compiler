      "description": "ESP32 runtime target",
      "capabilities": [
        "runtime.control",
        "motion.basic",
        "motion.speed",
        "sensor.ultrasonic",
        "sensor.touch",
        "sensor.light",
        "sensor.color",
        "sensor.line",
        "actuator.servo",
        "actuator.led",
        "actuator.motor",
        "line.follow",
        "peripheral.mp3",
        "peripheral.lizard",
