    },
    {
      "id": "arduino",
      "description": "Arduino Uno/Mega runtime target",
      "capabilities": [
        "runtime.control",
        "motion.basic",
        "motion.speed",
        "sensor.ultrasonic",
        "sensor.touch",
        "sensor.light",
        "sensor.color",
